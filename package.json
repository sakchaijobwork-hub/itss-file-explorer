{
  "name": "itss-file-explorer",
  "version": "0.3.3",
  "description": "Cross-platform File Explorer (macOS & Windows) built with Electron + React + TypeScript",
  "author": "ITSS",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "release:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "basic-ftp": "^6.2.6",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "exifr": "^7.1.3",
    "framer-motion": "^11.11.17",
    "jimp": "^1.6.1",
    "lucide-react": "^0.456.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2-sftp-client": "^12.1.1",
    "tar": "^7.5.23",
    "trash": "^8.1.1",
    "webdav": "^5.11.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/tar": "^6.1.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "th.co.itss.fileexplorer",
    "productName": "ITSS File Explorer",
    "artifactName": "ITSS-File-Explorer-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "sakchaijobwork-hub",
      "repo": "itss-file-explorer"
    }
  }
}
