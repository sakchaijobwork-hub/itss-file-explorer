<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Developer ID distribution (outside the Mac App Store) — this app is NOT
    sandboxed, so it can freely browse any folder/drive, watch arbitrary
    paths for automation, read the system Trash, etc. These entitlements are
    only what Hardened Runtime + notarization require for an Electron app
    to run and be signed correctly; they are unrelated to App Sandbox.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
